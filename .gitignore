# Modify add Git ignore rules for source-focused project backup, Michael Tan, 20260626

# Vivado projects and generated simulation outputs
project_*/
*.jou
*.log
*.pb
*.wdb
*.vcd
*.str
*.rpt
*.dcp
*.bit
*.ltx
*.cache/
*.hw/
*.ip_user_files/
*.runs/
*.sim/
*.srcs/
*.gen/
.Xil/
xsim.dir/

# Generated simulation work directories, separated by execution platform
vivado_sim_windows/design_compile/
vivado_sim_windows/*_sim/
vivado_sim_wsl/design_compile/
vivado_sim_wsl/*_sim/

# Manual backup folders and archives
test - *备份/
test - *备份.zip
*.zip

# Non-source report/material folder, keep out of code backup by default
kpi/

# Local handoff notes, keep only on this machine
AGENTS.md
README.md

# Keep weekly work records local, but track reusable code-analysis Markdown files.
file/*
!file/代码分析/
!file/代码分析/*.md
# Modify classify file records and track code analyses, Michael Tan, 20260825

# Temporary/editor files
# Modify ignore generated Python bytecode caches, Michael Tan, 20260729
__pycache__/
*.py[cod]
*.tmp
*.bak
~$*
.DS_Store
Thumbs.db
